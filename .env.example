# Supabase — REQUIRED. Without these the app keeps data in memory only and
# loses everything on restart. Project Settings > API Keys, then run
# supabase/schema.sql in the SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The app reads and writes exclusively with this key. RLS is enabled with no
# policies, so a publishable key alone can access nothing. Server-side only.
SUPABASE_SECRET_KEY=sb_secret_...

# Single-User Auth PIN (6 digits) — change this before going live
APP_ACCESS_PIN=

# Cron Secret Key (for the reminder endpoint) — use a long random string
CRON_SECRET=

# App URL — your real domain in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Provider Configuration (callmebot | meta | console)
WHATSAPP_PROVIDER=callmebot
CALLMEBOT_PHONE=                            # your number with country code, e.g. +91XXXXXXXXXX
CALLMEBOT_APIKEY=                           # key issued to you by CallMeBot

# AI Copilot Provider & Keys
AI_PROVIDER=openai                          # openai | google | groq
OPENAI_API_KEY=                             # OpenAI API Key
GOOGLE_GENERATIVE_AI_API_KEY=               # free at aistudio.google.com
AI_MODEL=gpt-4o-mini                        # gpt-4o-mini | gemini-2.5-flash | llama-3.3-70b-versatile
GROQ_API_KEY=                               # free at console.groq.com — used for voice STT
STT_PROVIDER=groq                           # groq | browser
STT_MODEL=whisper-large-v3-turbo
