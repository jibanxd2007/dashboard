# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Single-User Auth PIN (6 digits)
APP_ACCESS_PIN=123456

# Cron Secret Key (for reminder endpoint)
CRON_SECRET=crm_cron_secret_32_chars_random_val

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Provider Configuration (callmebot | meta | console)
WHATSAPP_PROVIDER=callmebot
CALLMEBOT_PHONE=+919876543210
CALLMEBOT_APIKEY=XojF4J8haTSy

# AI Copilot Provider & Keys
AI_PROVIDER=openai                          # openai | google | groq
OPENAI_API_KEY=                             # OpenAI API Key
GOOGLE_GENERATIVE_AI_API_KEY=               # free at aistudio.google.com
AI_MODEL=gpt-4o-mini                        # gpt-4o-mini | gemini-2.5-flash | llama-3.3-70b-versatile
GROQ_API_KEY=                               # free at console.groq.com — used for voice STT
STT_PROVIDER=groq                           # groq | browser
STT_MODEL=whisper-large-v3-turbo
